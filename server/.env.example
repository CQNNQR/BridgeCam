# BridgeCam Signaling Server Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port for the HTTP server (WebSocket uses SIGNALING_PATH under this port)
# Default: 3000
PORT=3000

# WebSocket signaling path
# Default: /ws
SIGNALING_PATH=/ws

# Node environment - affects logging format and debug features
# Options: development, production, test
# Default: development
NODE_ENV=development

# =============================================================================
# LOGGING
# =============================================================================

# Log level - controls verbosity of logging output
# Options: trace, debug, info, warn, error, fatal
# Default: info
LOG_LEVEL=info

# Enable worker threads for multi-core utilization
# Note: Workers are only used when this is set to 'true'
# Default: false
USE_WORKERS=false

# =============================================================================
# RATE LIMITING
# =============================================================================

# Time window for rate limiting (in milliseconds)
# Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum messages per rate limit window per client
# Default: 100
RATE_LIMIT_MAX_MESSAGES=100

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# Comma-separated list of allowed origins
# Use '*' to allow all origins (not recommended for production)
# Examples:
#   - "http://localhost:3000,http://127.0.0.1:3000"
#   - "https://your-domain.com"
#   - "*"
# Default: * (permissive for local development)
CORS_ORIGINS=*

# =============================================================================
# HTTPS / SSL CONFIGURATION
# =============================================================================

# Enable HTTPS/WSS support (requires SSL_KEY_PATH and SSL_CERT_PATH)
# Options: true, false
# Default: false
USE_HTTPS=false

# Path to SSL private key file (PEM format)
# Example: ./certs/server.key
SSL_KEY_PATH=

# Path to SSL certificate file (PEM format)
# Example: ./certs/server.crt
SSL_CERT_PATH=

# =============================================================================
# NGROK TUNNEL
# =============================================================================

# Ngrok authtoken - set directly to skip auto-detection from config files
# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Optional: Override the address ngrok tunnels to (default: PORT value)
# NGROK_ADDR=3000

# Optional: Limit tunnel bandwidth (e.g., '10M' for 10 MB/s)
# NGROK_BANDWIDTH=

# Optional: Custom metadata passed to ngrok API
# NGROK_METADATA=BridgeCam

# =============================================================================
# ROOM LIMITS
# =============================================================================

# Maximum number of concurrent rooms (0 = unlimited)
# Default: 0 (unlimited)
MAX_ROOMS=0

# Peer connection timeout in milliseconds
# Peers that don't send any message within this time are considered disconnected
# Default: 30000 (30 seconds)
PEER_TIMEOUT_MS=30000

# =============================================================================
# HEALTH CHECKS
# =============================================================================

# Interval for health check internal stats logging (in milliseconds)
# Default: 30000 (30 seconds)
HEALTH_CHECK_INTERVAL_MS=30000
